# ── agenzo-a2a-for-agent-toolkit configuration ────────────────────────────────
# Copy to `.env` (gitignored) and adjust, or set these as `env` in .kiro/settings/mcp.json.

# Orchestrator service address the client connects to. Behind a public gateway (e.g.
# https://agent-dev.agenzo.com) this host must route BOTH surfaces to the orchestrator-base service:
#   /a2a/*         — the conversation surface (requires a short-lived Bearer token)
#   /orch-public/* — the auth-free surface: agent onboarding (register/token), ride geocoding tools,
#                    and the EVO Drop-in card-binding page. No token required.
AGENZO_A2A_BASE_URL=http://localhost:8000

# Agent id (matches the orchestrator agent card {id}).
AGENZO_A2A_AGENT_ID=your_agent_id

# member_id = JWT sub = the end user placing the order. Payment methods and orders
# are isolated per (developer, member). Booking + payment must share the same member.
AGENZO_A2A_MEMBER_ID=your_member_id

# ── Auth: pick ONE way to obtain a developer api_key ─────────────────────────
# (a) Reuse an existing api_key directly (highest priority):
# AGENZO_A2A_API_KEY=your_api_key
#
# (b) Reuse a cached api_key file. Defaults to this project's ./api_key.local,
#     but you can point it at the orchestrator's cached key so it "just works":
# AGENZO_A2A_API_KEY_FILE=E:\work\gitlab-projects\ai-payment\agenzo-agent-orchestrator-base\scripts\prod\api_key.local
#
# (c) Self-register with an invitation code (used only when no api_key is found):
# AGENZO_A2A_INVITATION_CODE=AB12Cd

# Display name used when self-registering.
AGENZO_A2A_AGENT_NAME=kiro-agent

# Transport: 1 = streaming (message:stream, recommended), 0 = blocking (message:send).
AGENZO_A2A_STREAM=1

# HTTP timeout (seconds) for A2A calls.
AGENZO_A2A_HTTP_TIMEOUT=180

# ── Debug / raw A2A protocol visibility (all optional) ───────────────────────
# This bridge is primarily a debugging tool. The normal tool output is a normalized
# {state, text, cards[]} view — NOT the raw A2A message. The raw JSON-RPC is NEVER inlined
# into tool results (that would bloat the chat context); view it via the `inspect` tool (works
# regardless of AGENZO_A2A_DEBUG) or via the log file below.
#
# 1 = LOG each A2A exchange (request + response) to stderr (and to AGENZO_A2A_LOG_FILE when set).
# Does NOT inline raw traffic into tool results.
# AGENZO_A2A_DEBUG=0
#
# Write request/response traces to this file (in addition to stderr; requires AGENZO_A2A_DEBUG=1
# for full request/response detail). Never uses stdout (stdio transport reserves stdout for MCP).
# AGENZO_A2A_LOG_FILE=./a2a-trace.log
#
# How many recent exchanges inspect() keeps in memory.
# AGENZO_A2A_DEBUG_BUFFER=50
#
# Char cap applied to surfaced request/response bodies (0 disables the cap).
# AGENZO_A2A_DEBUG_MAXLEN=20000
