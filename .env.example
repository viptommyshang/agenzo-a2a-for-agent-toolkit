# ── agenzo-a2a-for-agent-toolkit configuration ────────────────────────────────
# Copy to `.env` (gitignored) and adjust, or set these as `env` in .kiro/settings/mcp.json.

# Orchestrator service address the client connects to.
AGENZO_A2A_BASE_URL=http://localhost:8000

# Agent id (matches the orchestrator agent card {id}).
AGENZO_A2A_AGENT_ID=your_agent_id

# member_id = JWT sub = the end user placing the order. Payment methods and orders
# are isolated per (developer, member). Booking + payment must share the same member.
AGENZO_A2A_MEMBER_ID=your_member_id

# ── Auth: pick ONE way to obtain a developer api_key ─────────────────────────
# (a) Reuse an existing api_key directly (highest priority):
# AGENZO_A2A_API_KEY=your_api_key
#
# (b) Reuse a cached api_key file. Defaults to this project's ./api_key.local,
#     but you can point it at the orchestrator's cached key so it "just works":
# AGENZO_A2A_API_KEY_FILE=E:\work\gitlab-projects\ai-payment\agenzo-agent-orchestrator-base\scripts\prod\api_key.local
#
# (c) Self-register with an invitation code (used only when no api_key is found):
# AGENZO_A2A_INVITATION_CODE=AB12Cd

# Display name used when self-registering.
AGENZO_A2A_AGENT_NAME=kiro-agent

# Transport: 1 = streaming (message:stream, recommended), 0 = blocking (message:send).
AGENZO_A2A_STREAM=1

# HTTP timeout (seconds) for A2A calls.
AGENZO_A2A_HTTP_TIMEOUT=180
